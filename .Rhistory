## basic nested loop..
mat <- matrix(1:20, nrow = 5)
mat
for (i in seq_along(nrow(mat))) {
for (j in ncol(mat)) {
print(mat[i, j])
}
}
for (i in seq_along(nrow(mat))) {
for (j in seq_along(ncol(mat))) {
print(mat[i, j])
}
}
x <- matrix(1:6, 2, 3)
for(i in seq_len(nrow(x))) {
for(j in seq_len(ncol(x))) {
print(x[i, j])
}
}
for (i in seq_along(nrow(mat))) {
for (j in seq_along(ncol(mat))) {
print(mat[i, j])
}
}
