for (j in seq_along(ncol(mat))) {
print(mat[i, j])
}
}
for (i in seq_along(nrow(mat))) {
for (j in seq_along(ncol(mat))) {
print(mat[i, j])
}
}
for (i in seq_len(nrow(mat))) {
for (j in seq_len(ncol(mat))) {
