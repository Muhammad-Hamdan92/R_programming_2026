## operations,  three types

#1) Arithmetics operators-------------
?base::Arithmetic  #help

x <- 12
y <- 10

x + y
x - y
x * y
x / y
x ^ y
x %% y        ##returns the remainder of a division)
x %/% y       ##returns the whole-number quotient


#comparison/relational operators---------

?Comparison

x < y    ## smaller than
x > y    ## greater than
x <= y   ## smaller than and equal to
x >= y   ## greater than and equal to 
x == y   ## equal to 
x != y   ## not equal to


  
## logical operators-------------
?base::logical    ## taking example from here.............

## non-zero values are TRUE
as.logical(c(pi,0))
if (length(letters)) cat("26 is TRUE\n")

## logical interpretation of particular strings
charvec <- c("FALSE", "F", "False", "false",    "fAlse", "0",
             "TRUE",  "T", "True",  "true",     "tRue",  "1")
as.logical(charvec)

## factors are converted via their levels, so string conversion is used
as.logical(factor(charvec))
as.logical(factor(c(0,1)))  # "0" and "1" give NA

