###Three Subsetting Operators in R

### 3. subsetting the list
## 1) using []
x <- list(pie = 1:4, chart = 0:6)
x[1]  ##Result is still a list.

##Using [[]]
x[[1]]   ##Result is the actual vector.
x <- list(pie =1:4,
          chart =0:8,
          well ="hello")              ##Extract Multiple List Elements
x[c(1,3)]

## using $ sign
x$chart
x <- list(added = 1:5)             ###Partial Matching
x$a

### different between $ and [[]]

###2. Subsetting Vectors...
x <- c("a","b","c","c","d","a")
x[1]    ##single element
x[c(1,3,4)]   ##for multiple elements
x[1:4]
x[x > "a"] ###logical subsetting

##3. Subsetting Matrices
x <- matrix(1:6, 2, 3)
x
x[1,2]  ### synx x[row,column]
x[2,]
x[,3]
###using the drop argument , keeps it matrix
x[1, ,drop=FALSE]  ##When writing functions, you often need the result to stay a matrix.
class(x[1,])
class(x[1,,drop=FALSE])
